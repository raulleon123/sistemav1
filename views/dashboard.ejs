<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistema de Fibra Óptica - Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <i class="bi bi-hdd-network-fill me-2"></i>FibraSystem
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link active" href="/"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/instalaciones/nueva"><i class="bi bi-plus-circle me-1"></i>Nueva Instalación</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid mt-4">
    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card stat-card bg-primary text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-subtitle mb-1 opacity-75">Total</h6>
                <h3 class="card-title mb-0" id="stat-total">0</h3>
              </div>
              <i class="bi bi-clipboard-data fs-1 opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card stat-card bg-success text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-subtitle mb-1 opacity-75">Completadas</h6>
                <h3 class="card-title mb-0" id="stat-completadas">0</h3>
              </div>
              <i class="bi bi-check-circle fs-1 opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card stat-card bg-warning text-dark">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-subtitle mb-1">Pendientes</h6>
                <h3 class="card-title mb-0" id="stat-pendientes">0</h3>
              </div>
              <i class="bi bi-clock fs-1 opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card stat-card bg-info text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-subtitle mb-1 opacity-75">Ingresos</h6>
                <h3 class="card-title mb-0">$<span id="stat-ingresos">0</span></h3>
              </div>
              <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Button -->
    <div class="text-center mb-4">
      <a href="/instalaciones/nueva" class="btn btn-primary btn-lg px-5 py-3 shadow">
        <i class="bi bi-plus-circle me-2"></i>Nueva Instalación de Fibra Óptica
      </a>
    </div>

    <!-- Recent Installations -->
    <div class="card shadow-sm">
      <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Últimas Instalaciones</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Código</th>
                <th>Cliente</th>
                <th>CI</th>
                <th>Plan</th>
                <th>Parroquia</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-instalaciones">
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">
                  <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                  No hay instalaciones registradas
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      // Cargar estadísticas
      try {
        const resp = await fetch('/api/estadisticas');
        const stats = await resp.json();
        document.getElementById('stat-total').textContent = stats.totalInstalaciones;
        document.getElementById('stat-completadas').textContent = stats.completadas;
        document.getElementById('stat-pendientes').textContent = stats.pendientes;
        document.getElementById('stat-ingresos').textContent = stats.ingresoTotal.toFixed(2);
      } catch (e) {
        console.error('Error cargando estadísticas:', e);
      }

      // Cargar últimas instalaciones
      try {
        const resp = await fetch('/api/ultimas-instalaciones');
        const instalaciones = await resp.json();
        const tbody = document.getElementById('tabla-instalaciones');

        if (instalaciones.length === 0) return;

        tbody.innerHTML = instalaciones.map(i => {
          const estadoBadge = {
            'completada': 'bg-success',
            'pendiente': 'bg-warning text-dark',
            'cancelada': 'bg-danger'
          };
          const fecha = new Date(i.fecha_creacion).toLocaleDateString('es-VE');
          return `<tr>
            <td><strong>${i.codigo}</strong></td>
            <td>${i.nombre_completo}</td>
            <td>${i.ci}</td>
            <td>${i.plan_nombre || '-'}</td>
            <td>${i.parroquia_nombre || '-'}</td>
            <td><span class="badge ${estadoBadge[i.estado] || 'bg-secondary'}">${i.estado}</span></td>
            <td>${fecha}</td>
            <td>
              <a href="/instalaciones/${i.id}/detalle" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>`;
        }).join('');
      } catch (e) {
        console.error('Error cargando instalaciones:', e);
      }
    });
  </script>
</body>
</html>
